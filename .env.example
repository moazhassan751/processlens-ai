# =============================================================================
# ProcessLens — Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to .env and configure the credentials for your environment.
# Never commit the actual .env file with real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase PostgreSQL Persistence (Optional - Local mode active if blank)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# -----------------------------------------------------------------------------
# 2. LLM Provider API Keys (At least one required for Phase 3 agentic consensus)
# -----------------------------------------------------------------------------
# Primary: Groq API Key (ultra-low latency inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Fallback: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 3. LLM Service Runtime & Gateway Controls
# -----------------------------------------------------------------------------
# Set to 'false' to force deterministic fallback across all explanation endpoints
LLM_ENABLED=true

# Active LLM provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# Model identifier for single-case explanations
LLM_MODEL=gpt-oss-20b

# Multi-Tier Agent Models for Phase 3 CrewAI committee
PRIMARY_MODEL=openai/gpt-oss-20b
VERIFIER_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini/gemini-3.5-flash

# Generation hyper-parameters (kept tight to enforce brevity and cost control)
LLM_MAX_OUTPUT_TOKENS=200
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=20

# Rate Limiting & Performance
LLM_MAX_REQUESTS_PER_MINUTE=10
LLM_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# 4. Pipeline & Subprocess Timeouts (seconds)
# -----------------------------------------------------------------------------
SUBPROCESS_TIMEOUT=120
PHASE3_TIMEOUT=300

# -----------------------------------------------------------------------------
# 5. Direct System Connectors (Phase G — Optional default database configuration)
# -----------------------------------------------------------------------------
# Default connection settings for external PostgreSQL process event ingestion.
# Used as default form prefill or automated pipeline ingestion.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_erp
POSTGRES_USER=processlens_reader
POSTGRES_PASSWORD=your_secure_db_password_here
POSTGRES_SCHEMA=public
POSTGRES_TABLE=process_events
POSTGRES_SSLMODE=prefer

# -----------------------------------------------------------------------------
# 6. Shared-Secret API Key Protection (Phase H6 — Optional write-endpoint guard)
# -----------------------------------------------------------------------------
# If unset or empty, write endpoints remain open (backward-compatible demo mode).
# If set, mutating endpoints require the 'X-API-Key: <API_KEY>' HTTP request header.
API_KEY=your-secret-here

